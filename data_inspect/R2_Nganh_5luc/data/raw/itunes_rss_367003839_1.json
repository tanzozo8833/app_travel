{"author":{"uri":{"label":"https://itunes.apple.com/vn/reviews/id977386633"}, "name":{"label":"Anji Nguyen"}, "label":""}, "updated":{"label":"2026-09-14T06:28:21-07:00"}, "im:rating":{"label":"5"}, "im:version":{"label":"69.6"}, "id":{"label":"14548926828"}, "title":{"label":"The Muse House Villa - Hoian"}, "content":{"label":"The location is pretty convenient for getting between Hoi An town and the villa. You can easily walk or ride a bicycle into town. The villa also offers bicycles and motorbike rentals. The owner is friendly and helpful. Breakfast is included, with Vietnamese coffee or fresh juice available depending on your preference.", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/vn/review?id=367003839&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
{"author":{"uri":{"label":"https://itunes.apple.com/vn/reviews/id1608770196"}, "name":{"label":"AndreiKavetski"}, "label":""}, "updated":{"label":"2026-09-14T03:24:36-07:00"}, "im:rating":{"label":"1"}, "im:version":{"label":"69.7"}, "id":{"label":"14548385513"}, "title":{"label":"They blocked my account for no reason"}, "content":{"label":"I am a frequent traveler and a booking user for more than 10 years, last week my account has been blocked because I don’t have access to my old phone number which I don’t have access to for years, despite I have access via email and Google Account \nThey don’t give you options to restore account without an old phone number.\nI have an ongoing booking and there is no way I can get help.\nSupport is telling they will be back in 48h but they do not respond, over and over again, and their phone support agent asks to write an email, which they don’t respond back.", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/vn/review?id=367003839&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
