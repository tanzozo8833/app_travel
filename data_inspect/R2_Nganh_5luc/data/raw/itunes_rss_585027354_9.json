{"author":{"uri":{"label":"https://itunes.apple.com/vn/reviews/id651386259"}, "name":{"label":"Someone511"}, "label":""}, "updated":{"label":"2026-07-15T20:13:21-07:00"}, "im:rating":{"label":"2"}, "im:version":{"label":"26.28.0"}, "id":{"label":"14308609506"}, "title":{"label":"Very frustrating experience."}, "content":{"label":"Whenever someone sends me a Google Maps link, I tap it and choose to open it in the app. Instead of opening the location, it always redirects me to the App Store to update Google Maps.\n\nThe most frustrating part is that even after I update the app, tapping the same link again still takes me back to the App Store instead of opening the location I actually want to see.\n\nThis has happened repeatedly, and it makes shared map links almost unusable. Please fix the link handling, it should open the destination, not keep redirecting users to the App Store.", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/vn/review?id=585027354&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
