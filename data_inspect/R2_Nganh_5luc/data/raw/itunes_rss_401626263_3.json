{"author":{"uri":{"label":"https://itunes.apple.com/vn/reviews/id1133404723"}, "name":{"label":"N ơi cho đi học"}, "label":""}, "updated":{"label":"2024-09-04T11:03:55-07:00"}, "im:rating":{"label":"1"}, "im:version":{"label":"24.35"}, "id":{"label":"11688785546"}, "title":{"label":"Dear Host - Never Trust Airbnb"}, "content":{"label":"Please landlords, do not choose airbnb because when a problem occurs, airbnb's problem handling team will always attribute the error to the landlord and make silly requests, for example, forcing you to respond to them within 1 hour even if it is in the middle of the night.\n\nIn addition, airbnb does not have a mechanism to respond to tenants' comments, all tenants' comments are posted even though they are the most unfounded comments.", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/vn/review?id=401626263&type=Purple%20Software"}}, "im:voteSum":{"label":"2"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"2"}}, 
