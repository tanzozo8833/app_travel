{"author":{"uri":{"label":"https://itunes.apple.com/vn/reviews/id1482783855"}, "name":{"label":"Benjamin Steelwell"}, "label":""}, "updated":{"label":"2023-09-13T02:59:45-07:00"}, "im:rating":{"label":"1"}, "im:version":{"label":"23.36"}, "id":{"label":"10363484296"}, "title":{"label":"Payment method bugs"}, "content":{"label":"Dear Airbnb app developers,\n\nPlease fix payment methods for Central Asian countries. I can’t set up my payment method. After I add my bank address and press “Continue to Worldpay” the screen just turns white and does not proceed to the next page. It seems like Worldpay does not work in country where I live, which is Kyrgyzstan. I am also struggling to use alternative Payoneer app. \nPlease fix this bug ASAP 👏🏼", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/vn/review?id=401626263&type=Purple%20Software"}}, "im:voteSum":{"label":"1"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"1"}}, 
