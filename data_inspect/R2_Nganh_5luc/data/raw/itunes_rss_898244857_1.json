{"author":{"uri":{"label":"https://itunes.apple.com/vn/reviews/id1025608034"}, "name":{"label":"原1111号"}, "label":""}, "updated":{"label":"2026-10-24T06:03:29-07:00"}, "im:rating":{"label":"1"}, "im:version":{"label":"5.55.2"}, "id":{"label":"14705342536"}, "title":{"label":"Lừa khách hàng -  You are deceiving your customers"}, "content":{"label":"I made two payments for the same booking reference. Traveloka confirmed that they would refund the second payment within 8 to 10 days. However, it has now been more than 12 days, and I have received no update or response. To make matters worse, the chat history was automatically closed without resolving my issue.", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/vn/review?id=898244857&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
{"author":{"uri":{"label":"https://itunes.apple.com/vn/reviews/id425305792"}, "name":{"label":"HoAhNam"}, "label":""}, "updated":{"label":"2026-10-23T09:08:57-07:00"}, "im:rating":{"label":"1"}, "im:version":{"label":"5.55.2"}, "id":{"label":"14701815842"}, "title":{"label":"Bait pricing"}, "content":{"label":"The listed price for one-way flight from SGN to DAD is around 670K VND but right before landing on the payment page, it announced that price has been changed, which is double? It happens exactly the same on my and my friend’s accounts. There is coincidence here! Why, traveloka?", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/vn/review?id=898244857&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
