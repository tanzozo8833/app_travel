rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profiles collection
    match /users/{userId} {
      // Any authenticated user can read profiles to view other travelers
      allow read: if isAuthenticated();

      // Users can only create, update, or delete their own profile
      allow write: if isOwner(userId);
    }

    // Community Posts collection
    match /posts/{postId} {
      // Any authenticated user can read all posts
      allow read: if isAuthenticated();

      // Only the author can create their post
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;

      // Only the author can delete their post
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;

      // Update rules:
      // 1. Author can update their own post completely (caption, media, etc.)
      // 2. Other authenticated users can ONLY update interaction counters (likeCount, saveCount, commentCount, shareCount, updatedAt)
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'saveCount', 'commentCount', 'shareCount', 'updatedAt'])
      );

      // Subcollection for Likes: /posts/{postId}/likes/{userId}
      // Keeps individual like track so users can only like once and toggle their own mark
      match /likes/{userId} {
        allow read: if isAuthenticated();
        allow create, delete: if isOwner(userId);
        allow update: if false;
      }

      // Subcollection for Saves: /posts/{postId}/saves/{userId}
      // Keeps individual save track so users can manage their own saved posts
      match /saves/{userId} {
        allow read: if isAuthenticated();
        allow create, delete: if isOwner(userId);
        allow update: if false;
      }

      // Subcollection for Comments: /posts/{postId}/comments/{commentId}
      match /comments/{commentId} {
        // Any authenticated user can read comments
        allow read: if isAuthenticated();

        // Only authenticated user can create a comment as themselves
        allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;

        // Only the comment author can edit or delete their comment
        allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      }
    }

    // Default rule: block access to any other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
