rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // User profiles collection
    match /users/{userId} {
      // Any authenticated user can read all profiles (needed to view other travelers' profiles)
      allow read: if request.auth != null;

      // Users can only create, update, or delete their own profile document
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Default rule: block access to any other collections not yet defined
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
